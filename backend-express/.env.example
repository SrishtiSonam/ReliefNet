# MongoDB Configuration
MONGO_URI=mongodb://mongo:27017/sdpd_db

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE=24h

# Server Configuration
PORT=5000
NODE_ENV=development

# ML Microservices URLs
FORECASTING_SERVICE_URL=http://forecasting_service:8001
ROUTING_SERVICE_URL=http://routing_service:8002
DECISION_SERVICE_URL=http://decision_service:8003

# Request Timeout (milliseconds)
REQUEST_TIMEOUT=30000
